+    /// Path A, MARGINAL fail-high (A(a) tuning campaign): stand-pat exceeds beta
+    /// but by < QS_PATHA_KEEP_MARGIN, so the Lower store is SUPPRESSED. qsearch
+    /// must still RETURN stand_pat, but produce ZERO TT stores and leave no
+    /// entry. Suppress-branch tripwire for the margin gate.
+    ///
+    /// Fixture: KvKR (eval ≈ +580). beta = eval − (margin−1) → margin = 99 < 100
+    /// (just-marginal). beta < eval so Path A still fires; the gate suppresses.
+    #[test]
+    fn qsearch_path_a_marginal_fail_high_suppresses_store() {
+        use crate::eval::evaluate;
+        use crate::tt::TranspositionTable;
+        let pos =
+            Position::from_fen("4k3/8/8/8/8/8/8/2R1K3 w - - 0 1").expect("KvKR FEN must parse");
+        let expected_eval = evaluate(&pos);
+        // Just below the keep margin: fail-high fires (beta <= eval) but the
+        // gap is < QS_PATHA_KEEP_MARGIN, so the store is suppressed.
+        let beta = expected_eval - (QS_PATHA_KEEP_MARGIN - 1);
+        assert!(
+            expected_eval >= beta && expected_eval - beta < QS_PATHA_KEEP_MARGIN,
+            "fixture invariant: marginal fail-high (beta <= eval < beta+margin); \
+             eval={expected_eval}, beta={beta}, margin={QS_PATHA_KEEP_MARGIN}"
+        );
+
+        let tt = Arc::new(TranspositionTable::new(1));
+        let mut ab = AlphaBetaMover::new();
+        ab.history = vec![pos.zobrist()];
+        ab.set_tt_for_test(Some(Arc::clone(&tt)));
+        let (ctx, _stop) = non_aborting_ctx();
+        let ply: u32 = 1;
+
+        let score = ab.qsearch_for_test(&mut pos.clone(), 0, beta, ply, &ctx);
+        assert_eq!(
+            score, expected_eval,
+            "qsearch must still return stand_pat on a suppressed fail-high; \
+             expected {expected_eval}, got {score}"
+        );
+        assert_eq!(
+            ab.qsearch_tt_stores_for_test(),
+            0,
+            "path A marginal fail-high must produce ZERO TT stores; got {}",
+            ab.qsearch_tt_stores_for_test()
+        );
+        assert!(
+            tt.probe(pos.zobrist()).is_none(),
+            "path A marginal fail-high must leave no TT entry (store suppressed)"
+        );
+    }
+
+    /// Path A, BOUNDARY fail-high (A(a) tuning campaign): stand-pat exceeds beta
+    /// by EXACTLY QS_PATHA_KEEP_MARGIN, so the `>=` gate KEEPS the store. Kills
+    /// the `>= → >` boundary mutant on the margin comparison.
+    ///
+    /// Fixture: KvKR (eval ≈ +580). beta chosen so margin == QS_PATHA_KEEP_MARGIN
+    /// exactly.
+    #[test]
+    fn qsearch_path_a_boundary_margin_stores() {
+        use crate::eval::evaluate;
+        use crate::tt::TranspositionTable;
+        let pos =
+            Position::from_fen("4k3/8/8/8/8/8/8/2R1K3 w - - 0 1").expect("KvKR FEN must parse");
+        let expected_eval = evaluate(&pos);
+        let beta = expected_eval - QS_PATHA_KEEP_MARGIN;
+        let tt = Arc::new(TranspositionTable::new(1));
+        let mut ab = AlphaBetaMover::new();
+        ab.history = vec![pos.zobrist()];
+        ab.set_tt_for_test(Some(Arc::clone(&tt)));
+        let (ctx, _stop) = non_aborting_ctx();
+        let ply: u32 = 1;
+
+        let score = ab.qsearch_for_test(&mut pos.clone(), 0, beta, ply, &ctx);
+        assert_eq!(score, expected_eval, "qsearch must return stand_pat");
+        assert_eq!(
+            ab.qsearch_tt_stores_for_test(),
+            1,
+            "margin == QS_PATHA_KEEP_MARGIN must KEEP the store (>= boundary); got {}",
+            ab.qsearch_tt_stores_for_test()
+        );
+        assert!(
+            tt.probe(pos.zobrist()).is_some(),
+            "boundary fail-high must leave a TT entry"
+        );
+    }
+
