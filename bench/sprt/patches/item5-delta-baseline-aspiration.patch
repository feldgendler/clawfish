+/// Volatility-responsive first-try aspiration half-width (item 5). Returns the
+/// fixed `ASPIRATION_HALF_WIDTH` fallback unless BOTH the last two completed ID
+/// iteration scores are known, in which case it returns
+/// `clamp(ASPIRATION_DELTA_K * |score_d1 - score_d2|, MIN, MAX)`.
+fn aspiration_half_width(score_d1: Option<i32>, score_d2: Option<i32>) -> i32 {
+    match (score_d1, score_d2) {
+        (Some(d1), Some(d2)) => {
+            (ASPIRATION_DELTA_K * (d1 - d2).abs()).clamp(ASPIRATION_DELTA_MIN, ASPIRATION_DELTA_MAX)
+        }
+        _ => ASPIRATION_HALF_WIDTH,
+    }
+}
