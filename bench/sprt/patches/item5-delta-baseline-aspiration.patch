+    // -----------------------------------------------------------------------
+    // Item-5 — aspiration_half_width unit tests.
+    // -----------------------------------------------------------------------
+
+    /// Without both d1 and d2, the fallback `ASPIRATION_HALF_WIDTH` is returned.
+    #[test]
+    fn aspiration_half_width_falls_back_without_d2() {
+        assert_eq!(aspiration_half_width(None, None), ASPIRATION_HALF_WIDTH);
+        assert_eq!(
+            aspiration_half_width(Some(100), None),
+            ASPIRATION_HALF_WIDTH
+        );
+        assert_eq!(aspiration_half_width(None, Some(50)), ASPIRATION_HALF_WIDTH);
+    }
+
+    /// A stable position (small or zero delta) clamps to `ASPIRATION_DELTA_MIN`.
+    #[test]
+    fn aspiration_half_width_clamps_to_min_on_stable() {
+        // delta 0: K*0 = 0 < MIN → MIN
+        assert_eq!(
+            aspiration_half_width(Some(100), Some(100)),
+            ASPIRATION_DELTA_MIN,
+        );
+        // delta 10: K*10 = 20 < MIN → MIN
+        assert_eq!(
+            aspiration_half_width(Some(50), Some(40)),
+            ASPIRATION_DELTA_MIN,
+        );
+    }
+
+    /// Width scales linearly with delta when the product is within [MIN, MAX].
+    #[test]
+    fn aspiration_half_width_scales_with_volatility() {
+        // delta 25: K*25 = 50 = ASPIRATION_HALF_WIDTH (the "median" calibration point)
+        assert_eq!(aspiration_half_width(Some(50), Some(25)), 50);
+        // delta 40: K*40 = 80
+        assert_eq!(aspiration_half_width(Some(100), Some(60)), 80);
+    }
+
+    /// Very large deltas clamp to `ASPIRATION_DELTA_MAX`.
+    #[test]
+    fn aspiration_half_width_clamps_to_max_on_high_volatility() {
+        // delta 1000: K*1000 = 2000 > MAX → MAX
+        assert_eq!(
+            aspiration_half_width(Some(0), Some(1000)),
+            ASPIRATION_DELTA_MAX,
+        );
+    }
+
+    /// `aspiration_window` uses the delta-derived half-width when both d1 and d2 are
+    /// available, and falls back to the fixed `ASPIRATION_HALF_WIDTH` when d2 is absent.
+    #[test]
+    fn aspiration_window_uses_delta_width() {
+        // delta 40 → half = 80 → window (100-80, 100+80) = (20, 180)
+        assert_eq!(
+            aspiration_window(Some(100), Some(60), 6),
+            (20, 180),
+            "prior=100, prior_prior=60 → half=80 → (20, 180)"
+        );
+        // no d2 → fallback half = ASPIRATION_HALF_WIDTH=50 → (50, 150)
+        assert_eq!(
+            aspiration_window(Some(100), None, 6),
+            (100 - ASPIRATION_HALF_WIDTH, 100 + ASPIRATION_HALF_WIDTH),
+            "prior=100, no prior_prior → fallback half=ASPIRATION_HALF_WIDTH"
+        );
+    }
