+    // -----------------------------------------------------------------------
+    // Item B — aspiration_half_width (depth-adaptive first-try width).
+    // Constants referenced symbolically so a future re-tune of the values does
+    // not falsely fail the SHAPE contract (base-at-threshold, monotone, floored).
+    // -----------------------------------------------------------------------
+
+    /// At the threshold depth the half-width equals the base (so threshold
+    /// behavior is identical to M4.D's fixed width).
+    #[test]
+    fn aspiration_half_width_equals_base_at_threshold() {
+        assert_eq!(
+            aspiration_half_width(ASPIRATION_MIN_DEPTH),
+            ASPIRATION_BASE_HALF_WIDTH,
+            "half-width at the threshold depth must equal the base"
+        );
+    }
+
+    /// `saturating_sub` => 0 narrowing steps for any depth at or below the
+    /// threshold, so the half-width is the base (the function is total even
+    /// though the caller never invokes it below threshold).
+    #[test]
+    fn aspiration_half_width_at_or_below_threshold_is_base() {
+        for d in 0..=ASPIRATION_MIN_DEPTH {
+            assert_eq!(
+                aspiration_half_width(d),
+                ASPIRATION_BASE_HALF_WIDTH,
+                "depth {d} <= threshold must give the base half-width"
+            );
+        }
+    }
+
+    /// Narrows by exactly `ASPIRATION_WIDTH_SLOPE` per ply beyond the threshold
+    /// (before the floor bites). Pins the slope and the `-`/`*` arithmetic.
+    #[test]
+    fn aspiration_half_width_narrows_by_slope_per_ply() {
+        assert_eq!(
+            aspiration_half_width(ASPIRATION_MIN_DEPTH + 1),
+            ASPIRATION_BASE_HALF_WIDTH - ASPIRATION_WIDTH_SLOPE,
+            "one ply beyond threshold: base - slope"
+        );
+        assert_eq!(
+            aspiration_half_width(ASPIRATION_MIN_DEPTH + 4),
+            ASPIRATION_BASE_HALF_WIDTH - 4 * ASPIRATION_WIDTH_SLOPE,
+            "four plies beyond threshold: base - 4*slope"
+        );
+    }
+
+    /// Monotone non-increasing across a wide depth range, always within
+    /// `[MIN_HALF_WIDTH, BASE_HALF_WIDTH]`, and saturated at the floor for large
+    /// depth. Pins the `.max(MIN)` clamp and the overall shape.
+    #[test]
+    fn aspiration_half_width_is_monotone_and_floored() {
+        let mut prev = i32::MAX;
+        for d in 0..=64u32 {
+            let hw = aspiration_half_width(d);
+            assert!(
+                hw <= prev,
+                "must be monotone non-increasing: depth {d} hw {hw} > prev {prev}"
+            );
+            assert!(
+                (ASPIRATION_MIN_HALF_WIDTH..=ASPIRATION_BASE_HALF_WIDTH).contains(&hw),
+                "depth {d}: hw {hw} outside [{ASPIRATION_MIN_HALF_WIDTH}, {ASPIRATION_BASE_HALF_WIDTH}]"
+            );
+            prev = hw;
+        }
+        assert_eq!(
+            aspiration_half_width(64),
+            ASPIRATION_MIN_HALF_WIDTH,
+            "deep iterations saturate at the floor"
+        );
+    }
