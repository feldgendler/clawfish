+    /// Item-3 gate: Path-A stand-pat fail-high is SUPPRESSED (no TT store) at
+    /// qs_depth >= QS_PATHA_SUPPRESS_DEPTH, but still RETURNS stand_pat. At
+    /// qs_depth == QS_PATHA_SUPPRESS_DEPTH - 1 (shallow) it still stores.
+    ///
+    /// Uses the same KvKR fixture as `qsearch_tt_store_stand_pat_fail_high_lower`
+    /// (stand-pat > beta is guaranteed by the fixture invariant check).
+    #[test]
+    fn qsearch_path_a_suppressed_at_deep_qs_depth() {
+        use crate::eval::evaluate;
+        use crate::tt::TranspositionTable;
+        let pos =
+            Position::from_fen("4k3/8/8/8/8/8/8/2R1K3 w - - 0 1").expect("KvKR FEN must parse");
+        let expected_eval = evaluate(&pos);
+        let beta = 10;
+        assert!(
+            expected_eval >= beta,
+            "fixture invariant: eval must be >= beta so stand-pat fail-high fires; \
+             eval={expected_eval}, beta={beta}"
+        );
+
+        let (ctx, _stop) = non_aborting_ctx();
+        let ply: u32 = 1;
+
+        // --- Shallow frame (qs_depth = QS_PATHA_SUPPRESS_DEPTH - 1): stores exactly 1.
+        let tt_shallow = Arc::new(TranspositionTable::new(1));
+        let mut ab_shallow = AlphaBetaMover::new();
+        ab_shallow.history = vec![pos.zobrist()];
+        ab_shallow.set_tt_for_test(Some(Arc::clone(&tt_shallow)));
+        let score_shallow = ab_shallow.qsearch_at_qs_depth_for_test(
+            &mut pos.clone(),
+            0,
+            beta,
+            ply,
+            QS_PATHA_SUPPRESS_DEPTH - 1,
+            &ctx,
+        );
+        assert_eq!(
+            score_shallow, expected_eval,
+            "shallow frame must still return stand_pat; expected {expected_eval}, got {score_shallow}"
+        );
+        assert_eq!(
+            ab_shallow.qsearch_tt_stores_for_test(),
+            1,
+            "shallow frame (qs_depth < SUPPRESS_DEPTH) must store exactly 1 TT entry; got {}",
+            ab_shallow.qsearch_tt_stores_for_test()
+        );
+        assert!(
+            tt_shallow.probe(pos.zobrist()).is_some(),
+            "shallow frame must leave a TT entry for the position"
+        );
+
+        // --- Deep frame (qs_depth = QS_PATHA_SUPPRESS_DEPTH): no store, but still returns stand_pat.
+        let tt_deep = Arc::new(TranspositionTable::new(1));
+        let mut ab_deep = AlphaBetaMover::new();
+        ab_deep.history = vec![pos.zobrist()];
+        ab_deep.set_tt_for_test(Some(Arc::clone(&tt_deep)));
+        let score_deep = ab_deep.qsearch_at_qs_depth_for_test(
+            &mut pos.clone(),
+            0,
+            beta,
+            ply,
+            QS_PATHA_SUPPRESS_DEPTH,
+            &ctx,
+        );
+        assert_eq!(
+            score_deep, expected_eval,
+            "deep frame must still return stand_pat even when store is suppressed; \
+             expected {expected_eval}, got {score_deep}"
+        );
+        assert_eq!(
+            ab_deep.qsearch_tt_stores_for_test(),
+            0,
+            "deep frame (qs_depth >= SUPPRESS_DEPTH) must NOT store a TT entry; got {}",
+            ab_deep.qsearch_tt_stores_for_test()
+        );
+        assert!(
+            tt_deep.probe(pos.zobrist()).is_none(),
+            "deep frame must leave NO TT entry for the position"
+        );
+    }
