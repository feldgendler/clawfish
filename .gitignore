# fastchess auto-writes config.json to its cwd on every run; the runbook
# convention is to invoke scripts/match.sh from REPO_ROOT, so the file lands
# at REPO_ROOT/config.json. (Other cwds either fall under /target or land
# outside the repo entirely and don't need a gitignore rule.)
/config.json

# M6.G/M6.H/M6.H2 corpus lanes: the ENTIRE bench/corpus/ tree is gitignored.
# Each lane (SelfPlayOnBook/OffBook, Ccrl, LichessOpen) lives in its own dir and
# is regenerable end-to-end — self-play deterministically from its seed/knobs,
# fetch from the pinned source URL — so neither the bytes (lane.bin can reach
# hundreds of MB / low GB) NOR the per-lane bookkeeping (manifest.json,
# re-run.sh, filter_spec.txt, corpus_stats.txt, fetch-state.json, checkpoint.bin,
# pending/, *.log) are tracked. The reproduction recipe lives in the repo
# itself: source URLs in docs/data-catalog.md and the campaign commands recorded
# alongside. Vendored fixtures (bench/data/, bench/*.md) are outside this tree
# and stay tracked. Future hosting (GitHub release asset / S3 / sister-repo) may
# publish a frozen canonical artifact for download. See ADR-0035 §8/§12.
/bench/corpus/
# Per-spill / per-stage operator artifacts.
/target/corpus-raw/
/target/corpus-spill/
/target/corpus-work/
/target/corpus-campaign.log

# texel-tune scratch outputs: the transient feature cache (can reach GBs), the
# meta-tune resume checkpoint, the human-readable progress file, and the
# `texel-tune apply`-input params JSON. All regenerable from the lanes + the
# recorded campaign command; the source of truth post-apply is `src/eval/data.rs`
# (the rewritten `TEXEL-TUNABLE` regions), so the JSON is intermediate scratch
# and never tracked.
/bench/*.mixcache
/bench/*.mixckpt
/bench/*.progress
/bench/*.json

# Campaign worktrees (M5.F qsearch tuning) — transient, do not track
.worktrees/
